# ─────────────────────────────────────────────────────────────
# Green Card Kosova — environment configuration
# Copy to .env.local and fill in. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# On Vercel, omit this to auto-derive the deployment URL, or set the final URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=sq

# ── Runtime mode ─────────────────────────────────────────────
# "postgres" uses Neon (DATABASE_URL). "demo" runs a fully local
# store with seed data and a labelled demo banner. When unset, the
# app uses Postgres if DATABASE_URL exists, otherwise demo.
APP_MODE=postgres

# Session signing key. Required (32+ chars) whenever APP_MODE=postgres.
# Demo mode falls back to a public key, so never put real applicant data in demo.
SESSION_SECRET=change-me-to-a-32-plus-character-random-string

# ── Neon Postgres (APP_MODE=postgres) ────────────────────────
# Pulled automatically by `neon env pull`. Run `npm run db:migrate` once
# to create the tables, then `npm run db:bootstrap -- you@example.com`.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=

# ── Email (magic-link sign-in and notifications) ─────────────
# resend | outbox (outbox = no delivery, visible in /admin/outbox)
EMAIL_PROVIDER=outbox
RESEND_API_KEY=
# Must be a verified Resend sender/domain. Required for delivery.
EMAIL_FROM=

# ── Payments ─────────────────────────────────────────────────
# disabled | stripe
PAYMENT_PROVIDER=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Bot protection (optional) ────────────────────────────────
# Rate limiting is active. Add a CAPTCHA provider before public launch if
# abuse is observed; no CAPTCHA integration ships with this build.

# ── DV year (verify against official instructions before launch) ──
DV_ACTIVE_YEAR=2027
DV_OPENS_AT=2026-10-01T00:00:00Z
DV_CLOSES_AT=2026-11-04T23:59:59Z
DV_INSTRUCTIONS_URL=https://dvprogram.state.gov/
DV_PHOTO_RULES_VERSION=2027.1

# ── Contact (approved values only) ───────────────────────────
CONTACT_EMAIL=info@greencardkosova.com
CONTACT_PHONE="+383 44 151 335"
OFFICE_ADDRESS="Rr. Eqrem Qabej Nr. 112, 10000 Prishtinë"
