# ─────────────────────────────────────────────────────────────
# Green Card Kosova — environment configuration
# Copy to .env.local and fill in. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# On Vercel, omit this to auto-derive the deployment URL, or set the final URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=sq

# Optional local demo storage root. Default: .data/. On Vercel, demo data uses
# Runtime Cache; /tmp is only a fallback when Runtime Cache is unavailable.
# DEMO_DATA_DIR=

# ── Runtime mode ─────────────────────────────────────────────
# "demo" runs a fully functional local store with seed data and a
# clearly labelled demo banner. "firebase" uses the real services
# below. Auto-detected when unset: firebase if all client vars exist.
APP_MODE=demo

# Session signing key. Required (32+ chars) for APP_MODE=firebase.
# In demo mode a public fallback key is used when this is absent, so a Vercel
# preview can run without secrets. Never put real applicant data in demo mode.
SESSION_SECRET=change-me-to-a-32-plus-character-random-string

# ── Firebase client (public, safe to expose) ────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (server only — never NEXT_PUBLIC_) ───────
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ── Email ────────────────────────────────────────────────────
# resend | outbox (outbox = no delivery, visible in /admin/outbox)
EMAIL_PROVIDER=outbox
RESEND_API_KEY=
# Must be a verified Resend sender/domain. Required for delivery.
EMAIL_FROM=

# ── Payments ─────────────────────────────────────────────────
# disabled | stripe
PAYMENT_PROVIDER=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Bot protection (optional) ────────────────────────────────
# Rate limiting is active. Add a CAPTCHA provider before public launch if
# abuse is observed; no CAPTCHA integration ships with this build.

# ── DV year (verify against official instructions before launch) ──
DV_ACTIVE_YEAR=2027
DV_OPENS_AT=2026-10-01T00:00:00Z
DV_CLOSES_AT=2026-11-04T23:59:59Z
DV_INSTRUCTIONS_URL=https://dvprogram.state.gov/
DV_PHOTO_RULES_VERSION=2027.1

# ── Contact (approved values only) ───────────────────────────
CONTACT_EMAIL=info@greencardkosova.com
CONTACT_PHONE="+383 44 151 335"
OFFICE_ADDRESS="Rr. Eqrem Qabej Nr. 112, 10000 Prishtinë"
